{
  "environment": "dokploy",
  "database": {
    "driver": "mysql",
    "host": "${DB_HOST}",
    "port": "3306",
    "username": "${DB_USER}",
    "password": "${DB_PASSWORD}",
    "name": "flightDb",
    "max_connections": 20,
    "max_idle_connections": 10,
    "max_lifetime": 2700,
    "max_idle_time": 2600
  },
  "server": {
    "port": "8081",
    "host": "0.0.0.0"
  },
  "resend": {
    "api_key": "${RESEND_API_KEY}",
    "from_email": "flighthours@rbsuport.com"
  },
  "verification": {
    "base_url": "${VERIFICATION_BASE_URL}"
  },
  "keycloak": {
    "server_url": "${KEYCLOAK_SERVER_URL}",
    "realm": "flighthours",
    "client_id": "emma",
    "client_secret": "${KEYCLOAK_CLIENT_SECRET}",
    "admin_user": "${KEYCLOAK_ADMIN}",
    "admin_pass": "${KEYCLOAK_ADMIN_PASSWORD}"
  },
  "id_encoder": {
    "secret": "${ID_ENCODER_SECRET}",
    "min_length": 10
  },
  "cookie": {
    "domain": "${COOKIE_DOMAIN}",
    "secure": true,
    "same_site": "none"
  }
}
