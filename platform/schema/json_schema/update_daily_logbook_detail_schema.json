{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Update Daily Logbook Detail Request",
  "description": "Schema for updating an existing flight segment in a daily logbook",
  "type": "object",
  "properties": {
    "flight_real_date": {
      "type": "string",
      "description": "Actual flight date in ISO 8601 format (YYYY-MM-DD)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "minLength": 1
    },
    "flight_number": {
      "type": "string",
      "description": "Flight number (numeric, up to 4 digits)",
      "pattern": "^\\d{1,4}$"
    },
    "origin_airport_id": {
      "type": "string",
      "description": "Origin airport ID (obfuscated ID)",
      "minLength": 1,
      "maxLength": 50
    },
    "destination_airport_id": {
      "type": "string",
      "description": "Destination airport ID (obfuscated ID)",
      "minLength": 1,
      "maxLength": 50
    },
    "tail_number_id": {
      "type": "string",
      "description": "Tail number ID (obfuscated ID)",
      "minLength": 1,
      "maxLength": 50
    },
    "passengers": {
      "type": "integer",
      "description": "Number of passengers",
      "minimum": 0
    },
    "out_time": {
      "type": "string",
      "description": "Block out time (HH:MM)",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "takeoff_time": {
      "type": "string",
      "description": "Takeoff time (HH:MM)",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "landing_time": {
      "type": "string",
      "description": "Landing time (HH:MM)",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "in_time": {
      "type": "string",
      "description": "Block in time (HH:MM)",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "pilot_role": {
      "type": "string",
      "description": "Pilot role: PF, PM, PFTO, or PFL",
      "enum": [
        "PF",
        "PM",
        "PFTO",
        "PFL"
      ]
    },
    "crew_role": {
      "type": "string",
      "description": "Crew position the logged-in pilot flew as on this flight",
      "enum": [
        "captain",
        "first officer",
        "instructor",
        "line check captain",
        "safety pilot"
      ]
    },
    "air_time": {
      "type": "string",
      "description": "Air time (HH:MM)",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "block_time": {
      "type": "string",
      "description": "Block time (HH:MM)",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "approach_category": {
      "type": "string",
      "description": "Approach category: RNP, ILS, VISUAL",
      "enum": [
        "RNP",
        "ILS",
        "VISUAL"
      ]
    },
    "approach_subtype": {
      "type": "string",
      "description": "Approach subtype — must match the selected approach_category (RNP: LNAV, LNAV/VNAV, RNP AR = 0.3, RNP AR < 0.3 — ILS: CAT I, CAT II, CAT III > 175, CAT III < 175 — empty/omitted for VISUAL)",
      "enum": [
        "LNAV",
        "LNAV/VNAV",
        "RNP AR = 0.3",
        "RNP AR < 0.3",
        "CAT I",
        "CAT II",
        "CAT III > 175",
        "CAT III < 175"
      ]
    },
    "autoland": {
      "type": "boolean",
      "description": "Whether an autoland was performed — only valid when approach_category is ILS"
    },
    "flight_type": {
      "type": "string",
      "description": "Flight type",
      "enum": [
        "COMMERCIAL",
        "TRAINING",
        "FERRY",
        "CHECK",
        "POSITIONING"
      ]
    },
    "crew": {
      "type": "array",
      "description": "Additional crew assigned to this flight leg (First Officer + cabin crew) — optional. Sending an empty array clears previously assigned crew. Each row is either an existing roster member (crew_member_id) or a brand-new person (name, created in the same save)",
      "items": {
        "type": "object",
        "properties": {
          "crew_member_id": {
            "type": "string",
            "description": "Crew member ID from the pilot's roster (obfuscated ID) — omit when sending name instead",
            "maxLength": 50
          },
          "name": {
            "type": "string",
            "description": "Full name of a brand-new crew member not yet in the roster — omit when sending crew_member_id instead",
            "maxLength": 150
          },
          "bp": {
            "type": "string",
            "description": "Crew member badge/ID number (optional, numeric)",
            "pattern": "^[0-9]+$",
            "maxLength": 16
          },
          "role": {
            "type": "string",
            "description": "Role for this assignment: first_officer, purser (Jefe de Cabina), or flight_attendant (Tripulante de Cabina)",
            "enum": [
              "first_officer",
              "purser",
              "flight_attendant"
            ]
          }
        },
        "required": [
          "role"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "flight_real_date",
    "flight_number",
    "origin_airport_id",
    "destination_airport_id",
    "tail_number_id"
  ],
  "additionalProperties": false
}
