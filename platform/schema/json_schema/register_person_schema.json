{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the person",
      "maxLength": 50,
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address",
      "maxLength": 150,
      "pattern": ".*\\S.*"
    },
    "password": {
      "type": "string",
      "description": "Access password (min 8 chars, at least 1 uppercase and 1 special character)",
      "minLength": 8,
      "maxLength": 64,
      "allOf": [
        {
          "pattern": "[A-Z]"
        },
        {
          "pattern": "[!@#$%^&*()_+\\-=\\[\\]{};':\\\"\\\\|,.<>/?`~]"
        }
      ]
    },
    "identificationnumber": {
      "type": "string",
      "description": "Identity document number (ID card, passport, DNI, etc.)",
      "maxLength": 10,
      "minLength": 7,
      "pattern": "^[0-9]+$"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date in ISO 8601 format (YYYY-MM-DD) - Optional at registration",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "End date in ISO 8601 format (YYYY-MM-DD) - Optional at registration",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "role": {
      "type": "string",
      "description": "Role of the person (immutable after registration)",
      "maxLength": 10,
      "minLength": 1,
      "enum": [
        "pilot"
      ],
      "errorMessage": "El cargo es inválido. Debe ser captain o first officer"
    }
  },
  "required": [
    "name",
    "email",
    "password",
    "identificationnumber",
    "role"
  ],
  "additionalProperties": false
}
