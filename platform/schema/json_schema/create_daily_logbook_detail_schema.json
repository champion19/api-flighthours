{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Create Daily Logbook Detail Request",
  "description": "Schema for creating a new flight segment in a daily logbook",
  "type": "object",
  "properties": {
    "flight_real_date": {
      "type": "string",
      "description": "Actual flight date in ISO 8601 format (YYYY-MM-DD)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "minLength": 1
    },
    "flight_number": {
      "type": "string",
      "description": "Flight number (numeric, up to 4 digits)",
      "pattern": "^\\d{1,4}$"
    },
    "airline_route_id": {
      "type": "string",
      "description": "Airline route ID (obfuscated ID)",
      "minLength": 1,
      "maxLength": 50
    },
    "tail_number_id": {
      "type": "string",
      "description": "Tail number ID (obfuscated ID)",
      "minLength": 1,
      "maxLength": 50
    },
    "passengers": {
      "type": "integer",
      "description": "Number of passengers",
      "minimum": 0
    },
    "out_time": {
      "type": "string",
      "description": "Block out time (HH:MM)",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "takeoff_time": {
      "type": "string",
      "description": "Takeoff time (HH:MM)",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "landing_time": {
      "type": "string",
      "description": "Landing time (HH:MM)",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "in_time": {
      "type": "string",
      "description": "Block in time (HH:MM)",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "pilot_role": {
      "type": "string",
      "description": "Pilot role: PF, PM, PFTO, or PFL",
      "enum": [
        "PF",
        "PM",
        "PFTO",
        "PFL"
      ]
    },
    "companion_name": {
      "type": "string",
      "description": "Name of the companion pilot (letters and spaces only)",
      "pattern": "^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ ]+$",
      "maxLength": 100
    },
    "crew_role": {
      "type": "string",
      "description": "Crew position: captain or  first officer",
      "enum": [
        "captain",
        "first officer"
      ]
    },
    "air_time": {
      "type": "string",
      "description": "Air time (HH:MM)",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "block_time": {
      "type": "string",
      "description": "Block time (HH:MM)",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "approach_type": {
      "type": "string",
      "description": "Approach type: APV, VISUAL",
      "enum": [
        "APV",
        "VISUAL"
      ]
    },
    "flight_type": {
      "type": "string",
      "description": "Flight type",
      "enum": [
        "COMMERCIAL",
        "TRAINING",
        "FERRY",
        "CHECK",
        "POSITIONING"
      ]
    }
  },
  "required": [
    "flight_real_date",
    "flight_number",
    "airline_route_id",
    "tail_number_id"
  ],
  "additionalProperties": false
}
