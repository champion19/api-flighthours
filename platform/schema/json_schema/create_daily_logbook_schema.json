{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Create Daily Logbook Request",
  "description": "Schema for creating a new daily logbook",
  "type": "object",
  "properties": {
    "log_date": {
      "type": "string",
      "description": "Logbook date in ISO 8601 format (YYYY-MM-DD)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "minLength": 1
    },
    "book_page": {
      "type": "integer",
      "description": "Physical book page number",
      "minimum": 1
    },
    "tail_number_id": {
      "type": "string",
      "description": "Tail number (aircraft registration) used for all flights logged under this book page"
    }
  },
  "required": [
    "log_date"
  ],
  "additionalProperties": false
}
