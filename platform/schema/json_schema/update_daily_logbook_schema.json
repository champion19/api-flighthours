{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Update Daily Logbook Request",
  "description": "Schema for updating an existing daily logbook",
  "type": "object",
  "properties": {
    "log_date": {
      "type": "string",
      "description": "Logbook date in ISO 8601 format (YYYY-MM-DD)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "minLength": 1
    },
    "book_page": {
      "type": "integer",
      "description": "Physical book page number",
      "minimum": 1
    },
    "status": {
      "type": "boolean",
      "description": "Logbook status (true = active, false = inactive)"
    }
  },
  "required": [
    "log_date"
  ],
  "additionalProperties": false
}
