{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Update Daily Logbook Request",
  "description": "Schema for updating an existing daily logbook",
  "type": "object",
  "properties": {
    "log_date": {
      "type": "string",
      "description": "Logbook date in ISO 8601 format (YYYY-MM-DD)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "minLength": 1
    },
    "book_page": {
      "type": "integer",
      "description": "Physical book page number",
      "minimum": 1
    },
    "status": {
      "type": "boolean",
      "description": "Logbook status (true = active, false = inactive)"
    },
    "tail_number_id": {
      "type": "string",
      "description": "Tail number (aircraft registration) used for all flights logged under this book page"
    },
    "crew_role": {
      "type": "string",
      "description": "Default crew role for every flight logged under this book page (editable per flight in Daily Logbook Detail)",
      "enum": [
        "captain",
        "first officer",
        "instructor",
        "line check captain",
        "safety pilot"
      ]
    }
  },
  "required": [
    "log_date"
  ],
  "additionalProperties": false
}
