# ============================================
# FlightHours — Variables de Entorno (Producción)
# ============================================
# Copiar este archivo como .env.production y completar los valores
# Generar passwords seguros con: openssl rand -base64 24
# ============================================

# ── MySQL App ────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_APP_PASSWORD=CHANGE_ME

# ── MySQL Keycloak ───────────────────────────
MYSQL_KC_ROOT_PASSWORD=CHANGE_ME

# ── Keycloak ─────────────────────────────────
KEYCLOAK_HOSTNAME=flighthours-auth.rbsuport.com
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
