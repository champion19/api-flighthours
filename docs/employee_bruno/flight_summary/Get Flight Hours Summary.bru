meta {
  name: Get Flight Hours Summary
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/employees/flight-hours-summary?reference_date=2026-02-22
  body: none
  auth: bearer
}

params:query {
  reference_date: 2026-02-22
  ~period: monthly
  ~start_date: 2026-01-01
  ~end_date: 2026-01-31
}

auth:bearer {
  token: {{access-token}}
}

docs {
  # Get Flight Hours Summary
  
  Returns total flight hours and breakdown by pilot role (PF, PM, PFTO, PFL),
  filtered by period.
  
  ## Authentication
  Requires Bearer token (run Login first).
  
  ## Query Parameters
  - `period` (required): `monthly`, `bimonthly`, `quarterly`, `semiannual`, `annual`, `custom`
  - `start_date` (optional): Start date (YYYY-MM-DD), **required if period=custom**
  - `end_date` (optional): End date (YYYY-MM-DD), **required if period=custom**
  - `reference_date` (optional): Reference date for period calculation (defaults to today)
  
  ## Success Response (200)
  ```json
  {
    "period": "monthly",
    "start_date": "2026-02-01",
    "end_date": "2026-02-28",
    "total_hours": "45:30",
    "total_flights": 12,
    "total_landings": 12,
    "breakdown": {
      "PF": "20:00",
      "PM": "15:30",
      "PFTO": "10:00",
      "PFL": "00:00"
    }
  }
  ```
  
  ## Errors
  - 400: Invalid period or missing custom dates
  - 401: Not authenticated
  - 500: Internal server error
}
